<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><c:out value="${titulo}"/> · EduGestión Secundaria</title>
  <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/demo.css">
</head>
<body>
<aside class="demo-sidebar" id="navigation">
  <a class="brand" href="${pageContext.request.contextPath}/demo/inicio"><span class="brand-icon">E</span><span>EduGestión<small>SECUNDARIA</small></span></a>
  <div class="school-label">CAMPUS DEMOSTRATIVO <span>Año 2026</span></div>
  <nav aria-label="Navegación principal">
    <c:forEach items="${paginas}" var="item" varStatus="it">
      <a class="nav-item ${pagina == item ? 'selected' : ''}" ${pagina == item ? 'aria-current="page"' : ''} href="${pageContext.request.contextPath}/demo/${item}"><span class="nav-dot" aria-hidden="true"></span><c:out value="${titulos[it.index]}"/></a>
    </c:forEach>
  </nav>
  <div class="sidebar-bottom"><span class="status-dot"></span> Sin conexión a MySQL<br><a href="${pageContext.request.contextPath}/index.jsp">Volver al acceso institucional ↗</a></div>
</aside>
<div class="demo-main">
  <header class="demo-topbar"><button class="menu-button" aria-label="Mostrar menú" aria-controls="navigation" aria-expanded="false" id="menuButton">☰</button><span class="institution">Gestión académica <span class="muted">/ Secundaria</span></span><div class="topbar-right"><span class="demo-badge">Modo demostración</span><span class="avatar">D</span><span class="user">Dirección<small>Perfil de muestra</small></span></div></header>
  <main id="main-content">
    <div class="breadcrumb">EduGestión <span>/</span> <c:out value="${titulo}"/></div>
    <div class="page-heading"><div><p class="eyebrow">ADMINISTRACIÓN ACADÉMICA</p><h1><c:out value="${titulo}"/></h1><p class="subtitle">Información clara para acompañar cada etapa del año escolar.</p></div><span class="year-pill">2026 · Tres trimestres</span></div>
    <div class="demo-notice"><span aria-hidden="true">◉</span><span><strong>Entorno de exposición.</strong> Datos ficticios compartidos entre módulos. Los formularios y solicitudes son prototipos; no guardan información ni autorizan operaciones reales.</span></div>

    <c:choose>
      <c:when test="${pagina == 'inicio'}">
        <section class="stats" aria-label="Resumen institucional">
          <a class="stat" href="${pageContext.request.contextPath}/demo/estudiantes"><span class="stat-icon">E</span><strong>${datos.estudiantes.size()}</strong><span>Estudiantes</span><small>Cinco grados de secundaria</small></a>
          <a class="stat" href="${pageContext.request.contextPath}/demo/docentes"><span class="stat-icon teal">D</span><strong>${datos.docentes.size()}</strong><span>Docentes</span><small>Responsables de cinco cursos</small></a>
          <a class="stat" href="${pageContext.request.contextPath}/demo/cursos"><span class="stat-icon violet">S</span><strong>${datos.secciones.size()}</strong><span>Secciones</span><small>Capacidad oficial: 30 por sección</small></a>
          <a class="stat" href="${pageContext.request.contextPath}/demo/cursos"><span class="stat-icon amber">C</span><strong>${datos.cursos.size()}</strong><span>Cursos activos</span><small>Oferta de muestra para cada grado</small></a>
        </section>
        <div class="dashboard-grid"><section class="card"><div class="card-heading"><div><h2>Seguimiento del día</h2><p>28 de octubre de 2026 · muestra de diez estudiantes</p></div><a href="${pageContext.request.contextPath}/demo/asistencia">Ver asistencia ↗</a></div><div class="attendance-summary"><div class="ring"><strong>80<small>%</small></strong></div><div><h3>Participación en clase</h3><p>7 presentes y 1 tardanza de 10 registros.</p><div class="legend"><span><i class="dot green"></i>7 presentes</span><span><i class="dot orange"></i>1 tardanza</span><span><i class="dot red"></i>1 falta</span><span><i class="dot blue"></i>1 justificada</span></div></div></div></section><section class="card"><h2>Agenda académica</h2><div class="timeline"><div><i class="dot green"></i><strong>Primer trimestre cerrado</strong><p>Notas de muestra definitivas.</p></div><div><i class="dot blue"></i><strong>Segundo trimestre en revisión</strong><p>Solicitud de cierre ilustrativa.</p></div><div><i class="dot orange"></i><strong>Tercer trimestre abierto</strong><p>Una recuperación pendiente en Matemática.</p></div></div><a class="text-link" href="${pageContext.request.contextPath}/demo/solicitudes">Revisar solicitudes →</a></section></div>
        <section class="card"><div class="card-heading"><div><h2>Accesos de gestión</h2><p>Recorre los procesos del colegio con un mismo escenario.</p></div></div><div class="quick-grid"><a href="${pageContext.request.contextPath}/demo/matriculas"><strong>Matrícula anual →</strong><span>Estudiante, sección y apoderado</span></a><a href="${pageContext.request.contextPath}/demo/calificaciones"><strong>Seguimiento académico →</strong><span>Ponderaciones y resultados provisionales</span></a><a href="${pageContext.request.contextPath}/demo/horarios"><strong>Horario semanal →</strong><span>Aulas, cursos y responsables</span></a><a href="${pageContext.request.contextPath}/demo/reportes"><strong>Reportes →</strong><span>Resumen por grado y sección</span></a></div></section>
        <section class="card"><h2>Actividad reciente · escenario ilustrativo</h2><ul class="activity"><li><span class="tag blue">Matrícula</span> Diez matrículas anuales activas distribuidas en cinco secciones.</li><li><span class="tag amber">Recuperación</span> Estudiante Beta tiene una evaluación pendiente en el tercer trimestre.</li><li><span class="tag green">Comunicado</span> Jornada de acompañamiento académico disponible para todos.</li></ul></section>
      </c:when>

      <c:when test="${pagina == 'estudiantes' || pagina == 'matriculas'}">
        <section class="card"><div class="card-heading"><div><h2>${pagina == 'estudiantes' ? 'Comunidad estudiantil' : 'Registro anual de matrícula'}</h2><p>Diez registros ficticios · año escolar 2026</p></div><button class="button primary" data-open="studentForm">+ ${pagina == 'estudiantes' ? 'Nuevo estudiante' : 'Nueva matrícula'}</button></div>
          <div class="toolbar"><label class="search">Buscar estudiante<input type="search" data-search="studentTable" placeholder="Nombre o código"></label><label>Grado<select data-filter="studentTable" data-column="2"><option value="">Todos los grados</option><c:forEach begin="1" end="5" var="g"><option value="${g}° A">${g}° secundaria</option></c:forEach></select></label><label>Estado<select data-filter="studentTable" data-column="3"><option value="">Todos</option><option>Activo</option></select></label></div>
          <div class="table-wrap"><table id="studentTable"><thead><tr><th>Código</th><th>Estudiante</th><th>Grado / sección</th><th>Estado</th><c:if test="${pagina == 'matriculas'}"><th>Apoderado principal</th></c:if><th>Acciones</th></tr></thead><tbody><c:forEach items="${datos.estudiantes}" var="e"><tr><td><span class="mono">${e.codigo}</span></td><td><strong><c:out value="${e.nombre}"/></strong><small>Año escolar 2026</small></td><td>${e.seccion}</td><td><span class="tag green">${e.estado}</span></td><c:if test="${pagina == 'matriculas'}"><td><c:out value="${e.apoderado}"/></td></c:if><td><a class="button small" href="${pageContext.request.contextPath}/demo/estudiantes?detalle=${e.id}">Ver detalle</a></td></tr></c:forEach></tbody></table></div><p class="empty-message" hidden>No se encontraron registros con esos filtros.</p>
        </section>
        <c:if test="${detalle > 0}"><c:set var="e" value="${datos.estudiantes[detalle - 1]}"/><section class="card detail-card"><span class="tag blue">Ficha ficticia</span><h2><c:out value="${e.nombre}"/></h2><div class="detail-grid"><div><small>Código interno</small><strong>${e.codigo}</strong></div><div><small>Grado y sección</small><strong>${e.seccion}</strong></div><div><small>Matrícula anual</small><strong>2026 · Activa</strong></div><div><small>Apoderado principal</small><strong><c:out value="${e.apoderado}"/></strong></div></div><p>No se incluyen documentos, teléfonos ni direcciones personales. La reconstrucción de la base de datos está pendiente.</p><a class="button" href="${pageContext.request.contextPath}/demo/calificaciones">Consultar notas de muestra →</a></section></c:if>
      </c:when>

      <c:when test="${pagina == 'docentes'}"><section class="card"><div class="card-heading"><div><h2>Equipo docente</h2><p>Un responsable por curso en cada sección de la muestra.</p></div><button class="button primary" data-demo>+ Nuevo docente</button></div><label class="search">Buscar docente<input type="search" data-search="teacherTable" placeholder="Nombre o especialidad"></label><div class="table-wrap"><table id="teacherTable"><thead><tr><th>Docente ficticio</th><th>Especialidad / curso</th><th>Secciones</th><th>Estado</th><th>Acción</th></tr></thead><tbody><c:forEach items="${datos.docentes}" var="d"><tr><td><strong><c:out value="${d.nombre}"/></strong></td><td><c:out value="${d.especialidad}"/></td><td>${d.secciones}</td><td><span class="tag green">${d.estado}</span></td><td><a class="button small" href="${pageContext.request.contextPath}/demo/docentes?detalle=${d.id}">Ver detalle</a></td></tr></c:forEach></tbody></table></div><p class="empty-message" hidden>No hay coincidencias.</p></section><c:if test="${detalle > 0 && detalle <= 5}"><c:set var="d" value="${datos.docentes[detalle - 1]}"/><section class="card"><span class="tag blue">Perfil ficticio</span><h2><c:out value="${d.nombre}"/></h2><p>Especialidad: <c:out value="${d.especialidad}"/>. Responsable del curso en primero a quinto, sección A.</p><p>Asignación ilustrativa vigente durante 2026. Los cambios históricos de responsabilidad requieren la futura integración.</p><a class="button" href="${pageContext.request.contextPath}/demo/horarios">Ver horario →</a></section></c:if></c:when>

      <c:when test="${pagina == 'cursos'}"><section class="card"><div class="card-heading"><div><h2>Oferta académica</h2><p>Los cinco cursos se ofrecen en cada una de las cinco secciones.</p></div><button class="button primary" data-demo>+ Configurar curso</button></div><div class="table-wrap"><table><thead><tr><th>Código</th><th>Curso</th><th>Docente responsable</th><th>Horas semanales</th><th>Estado</th></tr></thead><tbody><c:forEach items="${datos.cursos}" var="c"><tr><td class="mono">${c.codigo}</td><td><strong><c:out value="${c.nombre}"/></strong></td><td><c:out value="${c.docente}"/></td><td>${c.horas}</td><td><span class="tag green">Activo</span></td></tr></c:forEach></tbody></table></div></section><section class="card"><h2>Secciones · primero a quinto</h2><div class="table-wrap"><table><thead><tr><th>Sección</th><th>Aula</th><th>Tutor ficticio</th><th>Capacidad oficial</th><th>Ocupación de muestra</th></tr></thead><tbody><c:forEach items="${datos.secciones}" var="s"><tr><td><strong>${s.nombre}</strong></td><td>${s.aula}</td><td><c:out value="${s.tutor}"/></td><td>${s.capacidad}</td><td><span class="occupancy"><span style="width:7%"></span></span> ${s.ocupacion} / ${s.capacidad}</td></tr></c:forEach></tbody></table></div><p class="muted">No hay sobrecupos en este escenario. Las autorizaciones individuales son una funcionalidad futura.</p></section></c:when>

      <c:when test="${pagina == 'calificaciones'}"><div class="tabs" aria-label="Trimestre"><c:forEach begin="1" end="3" var="t"><a class="${trimestre == t ? 'active' : ''}" href="${pageContext.request.contextPath}/demo/calificaciones?trimestre=${t}">Trimestre ${t}</a></c:forEach></div><section class="card"><div class="card-heading"><div><h2>Matemática · trimestre ${trimestre}</h2><p>Ejemplo común a las cinco secciones. Tarea 30 % + práctica 30 % + examen 40 %.</p></div><span class="tag ${trimestre == 1 ? 'green' : trimestre == 2 ? 'blue' : 'amber'}">${trimestre == 1 ? 'Cerrado · muestra' : trimestre == 2 ? 'Cierre solicitado · muestra' : 'Abierto · muestra'}</span></div><div class="table-wrap"><table><thead><tr><th>Estudiante</th><th>Sección</th><th>Tarea · 30 %</th><th>Práctica · 30 %</th><th>Examen · 40 %</th><th>Promedio</th><th>Condición</th></tr></thead><tbody><c:forEach items="${notas}" var="n"><tr><td><strong><c:out value="${n.nombre}"/></strong></td><td>${n.seccion}</td><td>${n.tarea}</td><td>${n.practica}</td><td>${empty n.examen ? 'Pendiente' : n.examen}</td><td><strong>${empty n.promedio ? '—' : n.promedio}</strong></td><td><span class="tag ${n.estado == 'PROVISIONAL' ? 'amber' : n.estado == 'DEFINITIVO' ? 'green' : 'blue'}">${n.estado}</span></td></tr></c:forEach></tbody></table></div><p class="muted">Cálculo ilustrativo en Java con BigDecimal. Una recuperación pendiente nunca se transforma automáticamente en cero. No se ejecutan cierres reales.</p></section><c:if test="${trimestre == 3}"><section class="card recovery"><span class="tag amber">Recuperación de muestra</span><h2>Estudiante Beta · examen pendiente</h2><p>Justificación académica ilustrativa. Fecha límite individual de ejemplo: 06/11/2026. El promedio permanece provisional.</p><button class="button" data-demo>Revisar expediente de recuperación</button></section></c:if></c:when>

      <c:when test="${pagina == 'asistencia'}"><section class="card"><div class="card-heading"><div><h2>Registro diario · Matemática</h2><p>Fecha fija de la muestra: 28/10/2026. 7 presentes · 1 tardanza · 1 falta · 1 justificada.</p></div><button class="button primary" data-demo>Guardar asistencia · simulación</button></div><div class="toolbar"><label class="search">Buscar estudiante<input type="search" data-search="attendanceTable" placeholder="Nombre"></label><label>Estado<select data-filter="attendanceTable" data-column="2"><option value="">Todos</option><option>PRESENTE</option><option>TARDANZA</option><option>FALTA</option><option>JUSTIFICADA</option></select></label></div><div class="table-wrap"><table id="attendanceTable"><thead><tr><th>Estudiante</th><th>Sección</th><th>Estado de muestra</th><th>Fecha</th></tr></thead><tbody><c:forEach items="${datos.estudiantes}" var="e"><tr><td><strong><c:out value="${e.nombre}"/></strong></td><td>${e.seccion}</td><td><span class="tag ${e.asistencia == 'FALTA' ? 'red' : e.asistencia == 'TARDANZA' ? 'amber' : e.asistencia == 'JUSTIFICADA' ? 'blue' : 'green'}">${e.asistencia}</span></td><td>28/10/2026</td></tr></c:forEach></tbody></table></div><p class="empty-message" hidden>No hay registros con esos filtros.</p></section></c:when>

      <c:when test="${pagina == 'horarios'}"><section class="card"><div class="card-heading"><div><h2>Programación semanal</h2><p>Bloque ilustrativo de 08:00 a 09:00. Rotación sin conflictos en esta muestra; el horario completo de 4 horas por curso no está desarrollado.</p></div></div><label>Filtrar sección<select data-filter="scheduleTable" data-column="2"><option value="">Todas las secciones</option><c:forEach items="${datos.secciones}" var="s"><option>${s.nombre}</option></c:forEach></select></label><div class="table-wrap"><table id="scheduleTable"><thead><tr><th>Día</th><th>Hora</th><th>Sección</th><th>Aula</th><th>Curso</th><th>Docente</th></tr></thead><tbody><c:forEach items="${datos.horarios}" var="h"><tr><td>${h.dia}</td><td>${h.hora}</td><td>${h.seccion}</td><td>${h.aula}</td><td><c:out value="${h.curso}"/></td><td><c:out value="${h.docente}"/></td></tr></c:forEach></tbody></table></div></section></c:when>

      <c:when test="${pagina == 'solicitudes'}"><section class="card"><h2>Bandeja de decisiones · prototipo</h2><p>Los ejemplos describen la futura arquitectura; no conceden permisos ni modifican notas.</p><div class="table-wrap"><table><thead><tr><th>Proceso</th><th>Ámbito</th><th>Estado ilustrativo</th><th>Acción</th></tr></thead><tbody><tr><td>Cierre trimestral</td><td>Matemática · trimestre 2 · secciones de muestra</td><td><span class="tag blue">En revisión</span></td><td><button class="button small" data-demo>Revisar cierre</button></td></tr><tr><td>Recuperación justificada</td><td>Estudiante Beta · trimestre 3</td><td><span class="tag amber">Promedio provisional</span></td><td><a class="button small" href="${pageContext.request.contextPath}/demo/calificaciones?trimestre=3">Ver ejemplo</a></td></tr><tr><td>Corrección de nota</td><td>Sin solicitudes en esta muestra</td><td><span class="tag">Pendiente de integración</span></td><td><button class="button small" data-demo>Conocer proceso</button></td></tr></tbody></table></div></section></c:when>

      <c:when test="${pagina == 'anuncios'}"><section class="card"><div class="card-heading"><h2>Comunidad informada</h2><button class="button primary" data-demo>+ Publicar comunicado</button></div><article class="announcement"><span class="tag blue">TODOS · 28/10/2026</span><h2>Jornada de acompañamiento académico</h2><p>Comunicado ficticio para presentar el módulo de comunicación institucional. Revisa el seguimiento académico y las actividades del trimestre.</p><a class="text-link" href="${pageContext.request.contextPath}/demo/calificaciones">Consultar seguimiento →</a></article><article class="announcement"><span class="tag green">DOCENTES · muestra</span><h3>Revisión de ponderaciones</h3><p>La futura aprobación de cierres validará que las evaluaciones vigentes sumen 100 %.</p></article></section></c:when>

      <c:when test="${pagina == 'reportes'}"><section class="card"><div class="card-heading"><div><h2>Matrícula y ocupación por sección</h2><p>Resumen calculado sobre el catálogo ficticio. Exportación PDF/Excel no implementada.</p></div><button class="button" data-demo>Exportar · pendiente</button></div><div class="table-wrap"><table><thead><tr><th>Sección</th><th>Matriculados</th><th>Capacidad</th><th>Vacantes</th></tr></thead><tbody><c:forEach items="${datos.secciones}" var="s"><tr><td>${s.nombre}</td><td>${s.ocupacion}</td><td>${s.capacidad}</td><td>${s.capacidad - s.ocupacion}</td></tr></c:forEach></tbody></table></div><div class="quick-grid"><a href="${pageContext.request.contextPath}/demo/calificaciones">Promedios por trimestre →</a><a href="${pageContext.request.contextPath}/demo/asistencia">Resumen de asistencia →</a><a href="${pageContext.request.contextPath}/demo/horarios">Asignación y horario →</a></div></section></c:when>
    </c:choose>
    <footer class="demo-footer"><span>EduGestión Secundaria · Integrador I</span><span>Prototipo académico · Sin persistencia</span></footer>
  </main>
</div>
<dialog id="studentForm"><form id="sampleForm"><div class="card-heading"><div><span class="tag blue">Formulario visual</span><h2>Registro de muestra</h2></div><button class="icon-close" type="button" data-close aria-label="Cerrar">×</button></div><p>Este formulario permite explorar la interfaz; no crea estudiantes ni matrículas.</p><label>Nombre ficticio<input name="nombre" placeholder="Ejemplo de estudiante" maxlength="80" required></label><div class="detail-grid"><label>Grado<select name="grado"><c:forEach begin="1" end="5" var="g"><option>${g}° secundaria</option></c:forEach></select></label><label>Sección<select name="seccion"><option>A</option></select></label></div><label>Apoderado ficticio<input name="apoderado" placeholder="Responsable de muestra" maxlength="80" required></label><p class="muted">No introduzcas datos personales reales.</p><button class="button primary" type="submit">Previsualizar · no guardar</button></form></dialog>
<div class="toast" role="status" aria-live="polite" id="demoToast" hidden></div>
<script src="${pageContext.request.contextPath}/assets/js/demo.js"></script>
</body>
</html>
